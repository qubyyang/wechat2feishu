FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
FEISHU_APP_BASE_URL=https://open.feishu.cn
W2F_HISTORY_PATH=./data/history.json
W2F_CHROME_EXECUTABLE_PATH=
W2F_WECHAT_MP_TOKEN=
W2F_WECHAT_MP_COOKIE=
# 抓取限速（微信对 /cgi-bin/appmsgpublish 有独立频控配额，默认已按保守值设定）
W2F_WECHAT_LIST_INTERVAL_MS=3000
W2F_WECHAT_LIST_PAGE_SIZE=5
W2F_WECHAT_ARTICLE_INTERVAL_MS=1200
W2F_WECHAT_MAX_RETRIES=3
W2F_WECHAT_RETRY_BASE_MS=6000
# 正文资源本地化（图片默认下载进 ZIP 的 assets/ 目录，音视频默认关闭）
W2F_ASSET_INTERVAL_MS=300
W2F_ASSET_MAX_BYTES=20971520
W2F_DOWNLOAD_MEDIA=false
# 跨次增量导出的去重索引（不复用 history.json，后者有 100 条上限会漏判）
W2F_ARCHIVE_INDEX_PATH=./data/archive-index.json
# 流式导出时 ZIP 的服务端暂存目录与存活时长（SSE 只能传文本，二进制需落盘后二次领取）
W2F_EXPORT_JOB_DIR=./data/export-jobs
W2F_EXPORT_JOB_TTL_MS=1800000
# 定时增量归档（本服务不内置 cron，由外部定时器周期性 POST /api/schedule 触发）
W2F_SCHEDULE_ENABLED=false
W2F_SCHEDULE_ACCOUNTS=
W2F_SCHEDULE_INTERVAL_MS=86400000
W2F_SCHEDULE_FORMAT=markdown
W2F_SCHEDULE_LIMIT=0
W2F_SCHEDULE_ARCHIVE_DIR=./data/archives
W2F_SCHEDULE_STATE_PATH=./data/schedule-state.json

# 归档全文检索
W2F_SEARCH_INDEX_ENABLED=true
W2F_SEARCH_INDEX_PATH=./data/search-index.json
